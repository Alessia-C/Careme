# Copy to .env.local and fill in. Never commit real keys.
# Values: Supabase dashboard → Project Settings → API (or `vercel env pull .env.local`).

# --- Server-side (api/ functions, read via process.env) ---
SUPABASE_URL=https://<project-ref>.supabase.co
# Bypasses RLS. Server-side only: never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Client-side (exposed to the browser via import.meta.env) ---
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# --- Optional: run Playwright against an already running deployment ---
# E2E_BASE_URL=https://your-preview-url.vercel.app

# --- Sentry (error tracking) ---
# Same DSN for both: Sentry → Settings → Projects → careme → Client Keys (DSN)
# vercel dev reads the Development variables from the Vercel project
SENTRY_DSN=
VITE_SENTRY_DSN=